# ==========================================
# ISU-CAMP backend configuration
# ==========================================
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# ------------------------------------------
# Required
# ------------------------------------------

# Supabase / Postgres connection string.
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres

# Signs the admin session cookie. A shared, guessable, or committed value lets
# anyone forge an authenticated admin session, so generate a unique one per
# deployment and keep it out of version control:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The backend refuses to start without this unless ISUCAMP_ENV=development.
SECRET_KEY=

# ------------------------------------------
# Environment
# ------------------------------------------

# "development" relaxes two things for a local http://localhost run: a missing
# SECRET_KEY becomes a random per-process key, and the session cookie is sent
# over plain HTTP. Anything else (including unset) is treated as production.
ISUCAMP_ENV=production

# ------------------------------------------
# Browser origins
# ------------------------------------------

# Comma-separated list of origins allowed to call the API with credentials.
# This is both the CORS allowlist and the origin check on state-changing
# requests, so it must name the real admin portal URL in every deployment.
# Defaults to the Vite dev servers when unset.
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ------------------------------------------
# Session cookie (optional overrides)
# ------------------------------------------

# Send the session cookie over HTTPS only. Defaults to true in production.
SESSION_COOKIE_SECURE=true

# Cross-site policy for the session cookie. "Lax" blocks the usual CSRF
# submission while keeping ordinary navigation working. Use "Strict" for a
# tighter policy; never "None".
SESSION_COOKIE_SAMESITE=Lax

# Inactivity timeout, in minutes, after which the session expires.
SESSION_IDLE_MINUTES=60

# Largest accepted request body, in bytes (photo galleries allow ten 5 MB files).
MAX_CONTENT_LENGTH_BYTES=58720256

# ------------------------------------------
# Flask runtime (optional)
# ------------------------------------------

# Never enable in a deployment: the Werkzeug debugger offers an interactive
# Python console on any traceback.
FLASK_DEBUG=false
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# ------------------------------------------
# Outbound mail (password reset codes)
# ------------------------------------------

MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=onboarding@resend.dev
