# Copy outside the checkout and chmod 600. Supply actual values only at runtime.
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Required - the backend refuses to start without it. This signs the session
# cookie, so anyone holding it can forge a signed-in superadmin. Generate with
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SESSION_SECRET

# Session cookie. Secure keeps it off plaintext HTTP and needs TLS terminated
# in front of Nginx; until this deployment has that, set it to false or nobody
# can sign in. Lifetime is an idle timeout, refreshed on every request.
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=12
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=resend
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_DEFAULT_SENDER=REPLACE_WITH_VERIFIED_SENDER

# Backups. Restoring replaces the live database, so it stays off unless this
# deployment means it. The automatic backup needs pg_dump on the server and a
# BACKUP_DIR that outlives the container before it can work at all - see the
# backup section of the README.
BACKUP_RESTORE_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
# Daily, in UTC. 18:30 UTC is 02:30 Philippine time.
BACKUP_SCHEDULE_AT=18:30
# Archives kept, newest first, counting the ones taken by hand.
BACKUP_KEEP=14
# BACKUP_DIR=/var/lib/isu-camp/backups
